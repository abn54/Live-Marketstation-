{
  "name": "live-market-workstation",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node scripts/run-python.mjs -m server.main",
    "db:init": "node scripts/run-python.mjs -m scripts.init_db",
    "test": "node scripts/run-python.mjs -m pytest -q",
    "evidence": "node scripts/capture-evidence.js",
    "recording:import": "node scripts/run-python.mjs -m scripts.import_recording"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "vue": "^3.5.0",
    "ws": "^8.18.3",
    "@lucide/vue": "^1.70.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vue-tsc": "^3.0.0"
  }
}
