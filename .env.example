# No credentials are required. Python and the launcher load .env after copying.
HOST=127.0.0.1
PORT=3000
# FastAPI's internal development port; Vite proxies /api and /ws on PORT.
API_PORT=8000
DATABASE_PATH=./data/market.sqlite
POLL_INTERVAL_MS=15000
# Fault injection is disabled by default. Enable only for local demonstrations.
ENABLE_DEMO_CONTROLS=false
