# Yahoo requires no credentials. AI credentials belong only in ignored .env.local.
HOST=127.0.0.1
PORT=3000
# FastAPI's internal development port; Vite proxies /api and /ws on PORT.
API_PORT=8000
DATABASE_PATH=./data/market.sqlite
POLL_INTERVAL_MS=15000
# Fault injection is disabled by default. Enable only for local demonstrations.
ENABLE_DEMO_CONTROLS=false
# AI settings are read server-side from the environment, .env.local, then .env.
# Copy the names below to .env.local and enter your own key privately.
# Use a Google AI Studio project explicitly marked Free tier, with billing disabled.
# Never put this key in a VITE_ variable. No paid model fallback is implemented.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
# Set true in private configuration only after confirming Free tier/billing disabled.
GEMINI_FREE_TIER_CONFIRMED=false
